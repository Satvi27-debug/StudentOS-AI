# ------------------------------------------------------------------
# StudentOS AI — environment configuration
# Copy this file to `.env` and fill in what you have.
# The app degrades gracefully: it runs without any key, showing
# setup notices instead of crashing.
# ------------------------------------------------------------------

# --- AI (required for the AI Assistant) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional model override (provider/model format)
GEMINI_MODEL=google/gemini-2.5-flash

# --- Database (required for profile, study, tasks) ---
# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://studentos:studentos@localhost:5432/studentos

# --- Clerk auth (optional — app runs in local mode without it) ---
# Get keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
